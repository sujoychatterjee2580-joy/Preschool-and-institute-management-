datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Tenant {
  id                 String               @id @default(cuid())
  name               String
  slug               String               @unique
  code               String?              @unique
  address            String?
  phone              String?
  email              String?
  logoUrl            String?
  currency           String               @default("INR") // INR, BDT, USD
  plan               String               @default("PRO") // FREE, STARTER, PRO, ENTERPRISE
  subscriptionStatus String               @default("ACTIVE") // ACTIVE, TRIAL, PAST_DUE, CANCELLED
  metaWaPhoneId      String?
  metaWaAccessToken  String?
  metaWaVerifyToken  String?
  upiId              String?              // e.g. preschool@upi for direct instant payments
  razorpayKeyId      String?
  razorpayKeySecret  String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  users              User[]
  classes            ClassBatch[]
  students           Student[]
  parents            Parent[]
  invoices           FeeInvoice[]
  attendance         Attendance[]
  diaries            DailyKidDiary[]
  inquiries          AdmissionInquiry[]
  waLogs             WhatsAppMessageLog[]
  announcements      Announcement[]
}

model User {
  id           String      @id @default(cuid())
  tenantId     String
  name         String
  email        String      @unique
  passwordHash String      @default("password123")
  role         String      @default("OWNER") // OWNER, TEACHER, ADMIN, RECEPTIONIST
  phone        String?
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classes      ClassBatch[] @relation("TeacherClasses")
}

model ClassBatch {
  id               String       @id @default(cuid())
  tenantId         String
  name             String       // e.g. "Toddlers Playgroup", "Nursery Sunshine", "Maths Class 9"
  room             String?
  monthlyFee       Float        @default(1500)
  defaultStartTime String?      // e.g. "09:00 AM"
  defaultEndTime   String?      // e.g. "12:30 PM"
  teacherId        String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  tenant           Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacher          User?        @relation("TeacherClasses", fields: [teacherId], references: [id])
  students         Student[]
  attendance       Attendance[]
}

model Student {
  id                String       @id @default(cuid())
  tenantId          String
  classBatchId      String
  rollNumber        String
  firstName         String
  lastName          String
  dateOfBirth       DateTime?
  gender            String?      // BOY, GIRL
  photoUrl          String?
  status            String       @default("ACTIVE") // ACTIVE, INACTIVE, CHURN_RISK, GRADUATED
  joinDate          DateTime     @default(now())
  address           String?
  emergencyContact  String?
  qrCodeId          String       @unique @default(cuid())
  churnScore        Float        @default(12.5) // 0-100% risk prediction
  churnRiskFactors  String?      // JSON summary of AI churn explanation
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classBatch        ClassBatch   @relation(fields: [classBatchId], references: [id])
  parents           StudentParent[]
  invoices          FeeInvoice[]
  attendance        Attendance[]
  diaries           DailyKidDiary[]
}

model Parent {
  id             String          @id @default(cuid())
  tenantId       String
  name           String
  relationship   String          @default("MOTHER") // MOTHER, FATHER, GUARDIAN
  phone          String          // Primary WhatsApp number (with country code e.g. 919876543210)
  email          String?
  occupation     String?
  whatsappOptIn  Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  students       StudentParent[]
}

model StudentParent {
  id        String   @id @default(cuid())
  studentId String
  parentId  String
  isPrimary Boolean  @default(true)

  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent    Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@unique([studentId, parentId])
}

model FeeInvoice {
  id                 String    @id @default(cuid())
  tenantId           String
  studentId          String
  invoiceNumber      String    @unique
  month              String    // e.g. "November 2026"
  amount             Float
  discount           Float     @default(0)
  fine               Float     @default(0)
  netAmount          Float
  status             String    @default("PENDING") // PENDING, PAID, OVERDUE, PARTIAL
  dueDate            DateTime
  paidDate           DateTime?
  paymentMethod      String?   // UPI, CASH, CARD, ONLINE_LINK
  transactionRef     String?
  paymentLink        String?
  lastReminderSentAt DateTime?
  reminderCount      Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student            Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Attendance {
  id             String     @id @default(cuid())
  tenantId       String
  studentId      String
  classBatchId   String
  date           DateTime   // truncated to start of day
  status         String     @default("PRESENT") // PRESENT, ABSENT, LATE, EXCUSED
  checkInTime    String?    // e.g. "09:02 AM"
  checkOutTime   String?    // e.g. "12:35 PM"
  notifiedParent Boolean    @default(false)
  remarks        String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  tenant         Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student        Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classBatch     ClassBatch @relation(fields: [classBatchId], references: [id])

  @@unique([studentId, date])
}

model DailyKidDiary {
  id               String    @id @default(cuid())
  tenantId         String
  studentId        String
  date             DateTime  @default(now())
  mood             String    @default("HAPPY") // HAPPY, CALM, PLAYFUL, CRANKY, TIRED
  mealIntake       String    @default("FINISHED_ALL") // FINISHED_ALL, ATE_HALF, LITTLE, SKIPPED
  napMinutes       Int       @default(45)
  pottyCount       Int       @default(2)
  activities       String    // e.g. "Coloring fruits, Alphabet puzzle, Playground slide"
  photoUrls        String?   // Comma separated or JSON
  aiGeneratedNote  String?   // AI crafted sweet, professional daily message for WhatsApp
  sentViaWhatsApp  Boolean   @default(false)
  sentAt           DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student          Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model AdmissionInquiry {
  id              String    @id @default(cuid())
  tenantId        String
  parentName      String
  childName       String
  childAge        String?
  phone           String
  email           String?
  source          String    @default("WHATSAPP_BOT") // WHATSAPP_BOT, WEBSITE, WALK_IN, SOCIAL_MEDIA
  status          String    @default("NEW") // NEW, CONTACTED, DEMO_BOOKED, ENROLLED, LOST
  interestLevel   String    @default("HIGH") // HIGH, MEDIUM, LOW
  preferredClass  String?
  conversationLog String?   // JSON text of chat exchanges
  demoDate        DateTime?
  notes           String?
  followUpDate    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model WhatsAppMessageLog {
  id             String    @id @default(cuid())
  tenantId       String
  recipientPhone String
  recipientName  String?
  type           String    // FEE_REMINDER, ATTENDANCE_ALERT, DIARY_UPDATE, ADMISSION_BOT, ANNOUNCEMENT
  messageBody    String
  status         String    @default("SENT") // SENT, DELIVERED, READ, FAILED
  metaMessageId  String?
  createdAt      DateTime  @default(now())

  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Announcement {
  id          String   @id @default(cuid())
  tenantId    String
  title       String
  content     String
  targetGroup String   @default("ALL") // ALL, PLAYGROUP, NURSERY
  channel     String   @default("WHATSAPP")
  sentDate    DateTime @default(now())

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}
